MORALIS_API_KEY=...
ETHERSCAN_API_KEY=...
CRYPTOPANIC_API_KEY=

# Zerion (wallet balances + transaction history) — https://developers.zerion.io
ZERION_API_KEY=...

# AI chat provider — 'gemini' (default) or 'anthropic'
AI_PROVIDER=gemini
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# Only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

FRONTEND_URL=http://localhost:5173
PORT=3001

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Wallet snapshot TTL (ms) — on GET wallet / chat / market, refresh from indexer if older than this
WALLET_SNAPSHOT_TTL_MS=3600000

# Min interval between manual UI refreshes per address (ms)
WALLET_REFRESH_COOLDOWN_MS=30000

